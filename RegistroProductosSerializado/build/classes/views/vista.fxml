<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>

<GridPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="controllers.VistaController" hgap="10" vgap="10">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.halignment="RIGHT"/>
    <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <Label text="Precio:" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.halignment="RIGHT"/>
    <TextField fx:id="txtPrecio" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Categoria:" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.halignment="RIGHT"/>
    <ComboBox fx:id="cmbCategoria" prefWidth="150" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    <Button text="Agregar" onAction="#agregarProducto" GridPane.rowIndex="2" GridPane.columnIndex="2"/>

    <TableView fx:id="tablaProductos" prefWidth="330" GridPane.rowIndex="3" GridPane.columnIndex="0"
               GridPane.columnSpan="3">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="110"/>
            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100"/>
            <TableColumn fx:id="colCategoria" text="Categoria" prefWidth="110"/>
        </columns>
    </TableView>
    <Button text="Eliminar selec..." onAction="#eliminarSeleccionado" GridPane.rowIndex="3"
            GridPane.columnIndex="3" GridPane.valignment="TOP"/>
</GridPane>